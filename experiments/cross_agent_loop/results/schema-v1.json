{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cross-Agent Loop Phase 1 Result Schema v1",
  "description": "Provider-neutral result schema for benchmark case execution",
  "version": "1",
  "type": "object",
  "required": ["case_id", "provider", "timestamp", "oracle_result", "metadata"],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Provider-neutral case identity",
      "enum": ["P1-R1", "P1-R2", "P2-R1", "P2-R2", "P3-R1", "P3-R2"]
    },
    "provider": {
      "type": "string",
      "description": "AI provider/solver identity; never embedded in case truth"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of execution start"
    },
    "oracle_result": {
      "type": "string",
      "description": "Recorded terminal outcome. TIMEOUT is an execution lifecycle outcome and is not automatically a provider failure.",
      "enum": [
        "PASS",
        "SYNTAX_FAIL",
        "SEMANTIC_FAIL",
        "SCOPE_FAIL",
        "NO_OUTPUT",
        "TIMEOUT",
        "HARNESS_ERROR",
        "CONTROL_PLANE_FAIL"
      ]
    },
    "result_state": {
      "type": "string",
      "enum": ["RESULT_RECORDED"],
      "description": "All terminal outcomes are persisted through the same provider-neutral result state."
    },
    "provider_failure_eligible": {
      "type": "boolean",
      "description": "Whether this result may be counted in provider capability scoring after classification. HARNESS_ERROR and CONTROL_PLANE_FAIL must be false; TIMEOUT requires caller classification and defaults false in the harness simulation."
    },
    "oracle_checks": {
      "type": "object",
      "properties": {
        "syntax_import_succeeds": {"type": "boolean"},
        "function_signature_exists": {"type": "boolean"},
        "valid_fixture_normalized_exactly": {"type": "boolean"},
        "malformed_required_field_rejected": {"type": "boolean"},
        "unknown_field_rejected": {"type": "boolean"},
        "deterministic_repeated_run": {"type": "boolean"},
        "only_allowed_path_changed": {"type": "boolean"}
      }
    },
    "metadata": {
      "type": "object",
      "required": ["duration_seconds", "prompt_pattern"],
      "properties": {
        "duration_seconds": {"type": "number", "minimum": 0},
        "prompt_pattern": {
          "type": "string",
          "enum": ["P1_NATURAL", "P2_STRUCTURED", "P3_CONTRACT"]
        },
        "repetition": {"type": "integer", "minimum": 1, "maximum": 2},
        "solver_output": {"type": "string"},
        "git_diff_stat": {
          "type": "object",
          "properties": {
            "files_changed": {"type": "integer"},
            "insertions": {"type": "integer"},
            "deletions": {"type": "integer"},
            "modified_paths": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "error_details": {"type": "string"}
  },
  "additionalProperties": false
}
